# Database credentials for docker-compose.yml.
#
#   cp .env.example .env && chmod 600 .env
#
# then replace both "change-me" values. install.sh does this for you with
# random passwords when .env does not exist. Never commit .env.
#
# Generate a strong password (32 letters and digits):
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; echo
#
# Avoid $, quotes and spaces in values: Compose expands $ inside .env.
#
# MariaDB applies these ONLY when the database volume is first created.
# Editing them later does not change existing passwords — see README,
# "Database credentials".

# MariaDB root account: administration only. Never put it in wp-config.php.
MARIADB_ROOT_PASSWORD=change-me

# Database and account that WordPress uses; created on first start.
MARIADB_DATABASE=wordpress
MARIADB_USER=wordpress
MARIADB_PASSWORD=change-me
